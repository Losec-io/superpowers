#!/usr/bin/env bash
# Stop hook: quality gate enforcement before session completion.
#
# Checks for uncommitted changes, failing tests, and unfinished tasks.
# Outputs a reminder if any gates are open.
#
# Opt-out: SUPERPOWERS_STOP_GATE=0

set -euo pipefail

[[ "${SUPERPOWERS_STOP_GATE:-1}" == "0" ]] && exit 0

INPUT=$(cat)
CWD=$(echo "$INPUT" | jq -r '.cwd // ""' 2>/dev/null | tr -d '\r') || CWD=""
[[ -z "$CWD" ]] && CWD="$PWD"

warnings=()

# Check for uncommitted changes
if git -C "$CWD" status --porcelain 2>/dev/null | grep -q '^'; then
    warnings+=("Uncommitted changes detected — consider committing or stashing before ending session")
fi

# Check for unfinished plan tasks (unchecked boxes in plan files)
PLAN_DIR="$CWD/docs/superpowers/plans"
if [[ -d "$PLAN_DIR" ]]; then
    unchecked=$(grep -r '^\- \[ \]' "$PLAN_DIR" 2>/dev/null | wc -l | tr -d ' ') || unchecked=0
    if [[ "$unchecked" -gt 0 ]]; then
        warnings+=("$unchecked unchecked task(s) remain in plan files under docs/superpowers/plans/")
    fi
fi

if [[ ${#warnings[@]} -eq 0 ]]; then
    exit 0
fi

# Build reminder message
msg="Before ending this session, please address:\n"
for w in "${warnings[@]}"; do
    msg+="  - $w\n"
done
msg+="\nDisable this check with SUPERPOWERS_STOP_GATE=0"

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

escaped=$(escape_for_json "$msg")

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "Stop",\n    "suppressOutput": false,\n    "message": "%s"\n  }\n}\n' "$escaped"

exit 0
