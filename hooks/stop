#!/usr/bin/env bash
# Stop hook: quality gate — reminds about uncommitted changes and unfinished tasks.
#
# On Claude Code: outputs additionalContext with the reminder.
# On Codex: outputs decision:"block" with the reason, causing Codex to continue.
#
# Opt-out: SUPERPOWERS_STOP_GATE=0

set -uo pipefail

[[ "${SUPERPOWERS_STOP_GATE:-1}" == "0" ]] && exit 0

INPUT=$(cat) || INPUT="{}"
CWD=$(echo "$INPUT" | jq -r '.cwd // ""' 2>/dev/null | tr -d '\r') || CWD=""
[[ -z "$CWD" ]] && CWD="$PWD"

warnings=()

if git -C "$CWD" status --porcelain 2>/dev/null | grep -q '^'; then
    warnings+=("Uncommitted changes detected — consider committing or stashing before ending session")
fi

PLAN_DIR="$CWD/docs/superpowers/plans"
if [[ -d "$PLAN_DIR" ]]; then
    unchecked=$(grep -rc '^\- \[ \]' "$PLAN_DIR" 2>/dev/null | awk -F: '{s+=$2} END {print s+0}') || unchecked=0
    if [[ "$unchecked" -gt 0 ]]; then
        warnings+=("$unchecked unchecked task(s) remain in plan files under docs/superpowers/plans/")
    fi
fi

if [[ ${#warnings[@]} -eq 0 ]]; then
    echo '{}'
    exit 0
fi

msg="Before ending this session, please address:"
for w in "${warnings[@]}"; do
    msg+=$'\n'"  - $w"
done
msg+=$'\n\n'"Disable this check with SUPERPOWERS_STOP_GATE=0"

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

escaped=$(escape_for_json "$msg")

if [[ -n "${CODEX_HOME:-}" || -n "${CODEX_CI:-}" || -n "${CODEX_SANDBOX_DIR:-}" ]]; then
    printf '{"decision":"block","reason":"%s"}\n' "$escaped"
else
    printf '{"decision":"block","reason":"%s"}\n' "$escaped"
fi

exit 0
